{
  "name": "@distill/app",
  "version": "0.0.20",
  "private": true,
  "description": "distill: local-first business meeting summarisation. Transcribes recordings on-device, summarises via Ollama, writes Markdown / HTML / Apple Notes. Supports Plaud as one source.",
  "author": "Si Greenwood",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w better-sqlite3,keytar",
    "prepackage": "npm run rebuild && npm run build",
    "package": "electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "keytar": "^7.9.0",
    "marked": "^14.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@plaud/core": "*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
