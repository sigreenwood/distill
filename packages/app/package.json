{
  "name": "@distill/app",
  "version": "0.0.32",
  "private": true,
  "description": "distill: local-first business meeting summarisation. Transcribes recordings on-device, summarises via Ollama, writes Markdown / HTML / Apple Notes. Supports Plaud as one source.",
  "author": "Si Greenwood",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w better-sqlite3,keytar",
    "prepackage": "npm run rebuild && npm run build",
    "package": "electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "keytar": "^7.9.0",
    "marked": "^18.0.14",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@plaud/core": "*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
